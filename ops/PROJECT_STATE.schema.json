{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tsuchimaru Project State",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "display_name",
    "as_of",
    "risk_tier",
    "current_stage",
    "status",
    "canonical",
    "locked",
    "last_pass",
    "open_findings",
    "next_action",
    "human_approval_required",
    "audit_mode",
    "model_route",
    "source_of_truth",
    "migration_note"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "risk_tier": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "current_stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "canonical": {
      "type": "string",
      "minLength": 1
    },
    "locked": {
      "type": "boolean"
    },
    "lock_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_pass": {
      "type": "string"
    },
    "open_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_approval_required": {
      "type": "boolean"
    },
    "audit_mode": {
      "type": "string",
      "minLength": 1
    },
    "model_route": {
      "type": "object",
      "required": [
        "routine",
        "analysis",
        "final_gate"
      ],
      "properties": {
        "routine": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "final_gate": {
          "type": "string"
        }
      }
    },
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "migration_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
